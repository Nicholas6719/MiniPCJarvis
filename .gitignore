# Node
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Python
__pycache__/
*.pyc
.venv/
venv/
sidecar/build/
sidecar/dist/
*.spec.bak

# Models / large binaries (never commit weights)
*.gguf
*.onnx
models/

# Logs / local data
*.log
*.db
*.db-shm
*.db-wal

# Secrets — never commit
.env
*.dpapi

# OS
Thumbs.db
desktop.ini

# Build artifacts / downloaded installers (a 1.4 MB SDK setup was committed once)
tsconfig.tsbuildinfo
*-Setup.exe
*.msi

# Test result dumps — machine-specific, regenerated on every run
sidecar/tests/*-results.json
sidecar/tests/kw_*.json

# JARVIS's own browser profile, should it ever land inside the repo
browser-profile/
session-browser/

# The agent's own working files: real-session .cmd helpers, copied logs,
# HUD screenshots, and the current port/token. Never part of the product.
.agent/
